[313.413409, "i", "cat > /app/fit.py << 'EOF'\nimport numpy as np, json\nfrom scipy.optimize import curve_fit\nconv = lambda s: float(s.replace(',','.'))\ndata = np.loadtxt('/app/graphene.dat', converters={0:conv,1:conv}, encoding=None)\nshift = 1e7/data[:,0]\ny = data[:,1]\nidx = np.argsort(shift)\nshift, y = shift[idx], y[idx]\n\ndef lorentz(x, x0, gamma, amplitude, offset):\n    return offset + amplitude * gamma**2 / ((x-x0)**2 + gamma**2)\n\ndef fitpeak(lo, hi, x0g):\n    m = (shift>=lo)&(shift<=hi)\n    xs, ys = shift[m], y[m]\n    off0 = ys.min()\n    amp0 = ys.max()-off0\n    p0 = [x0g, 15, amp0, off0]\n    popt, pcov = curve_fit(lorentz, xs, ys, p0=p0)\n    perr = np.sqrt(np.diag(pcov))\n    print('fit:', popt, 'err:', perr, 'npts:', len(xs))\n    return popt\n\ngG = fitpeak(1500, 1660, 1580)\ng2D = fitpeak(2550, 2800, 2670)\nres = {\n  'G': {'x0': float(gG[0]), 'gamma': float(abs(gG[1])), 'amplitude': float(gG[2]), 'offset': float(gG[3])},\n  '2D': {'x0': float(g2D[0]), 'gamma': float(abs(g2D[1])), 'amplitude': float(g2D[2]), 'offset': float(g2D["]
[313.413499, "i", "3])}\n}\nwith open('/app/results.json','w') as f:\n    json.dump(res, f, indent=2)\nprint(json.dumps(res, indent=2))\nEOF\npython3 /app/fit.py\n"]
