[266.446403, "i", "cat > /app/peek2.py << 'EOF'\nimport numpy as np\nconv = lambda s: float(s.replace(',','.'))\ndata = np.loadtxt('/app/graphene.dat', converters={0:conv,1:conv}, encoding=None)\nx, y = data[:,0], data[:,1]\nprint('monotonic decreasing:', np.all(np.diff(x)<0))\nidx = np.argsort(x); x,y = x[idx], y[idx]\nd = np.diff(x)\nprint('spacing min/max:', d.min(), d.max())\n# check if 1/x linear in index\ninvx = 1/x\ndd = np.diff(invx)\nprint('d(1/x) first 3:', dd[:3], 'mid:', dd[len(dd)//2-1:len(dd)//2+2], 'last 3:', dd[-3:])\nfrom scipy.signal import find_peaks\npeaks, props = find_peaks(y, prominence=800, width=3)\nfor p,w,prom in zip(peaks, props['widths'], props['prominences']):\n    # width in x units\n    wx = w * (x[min(p+1,len(x)-1)]-x[max(p-1,0)])/2\n    print('peak x=%.2f y=%.1f prom=%.0f width_pts=%.1f width_x=%.2f' % (x[p], y[p], prom, w, wx))\nEOF\npython3 /app/peek2.py\n"]
