[313.414289, "o", "shift = 1e7/data[:,0]\r\n\u001b[?2004l\r"]
[313.414306, "o", "\u001b[?2004h> "]
[313.414334, "o", "y = data[:,1]\r\n\u001b[?2004l\r"]
[313.414365, "o", "\u001b[?2004h"]
[313.414381, "o", "> "]
[313.414426, "o", "idx = np.argsort(shift)\r\n\u001b[?2004l\r"]
[313.414457, "o", "\u001b[?2004h> "]
[313.414541, "o", "shift, y = shift[idx], y[idx]\r\n\u001b[?2004l\r"]
[313.414567, "o", "\u001b[?2004h> "]
[313.414599, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[313.4147, "o", "def lorentz(x, x0, gamma, amplitude, offset):\r\n\u001b[?2004l\r"]
[313.414731, "o", "\u001b[?2004h"]
[313.414758, "o", "> "]
[313.414893, "o", "    return offset + amplitude * gamma**2 / ((x-x0)**2 + gamma**2)\r\n\u001b[?2004l\r"]
[313.414923, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[313.415011, "o", "\u001b[?2004h> def fitpeak(lo, hi, x0g):\r\n\u001b[?2004l\r"]
[313.415036, "o", "\u001b[?2004h"]
[313.415059, "o", "> "]
[313.415126, "o", "    m = (shift>=lo)&(shift<=hi)\r\n\u001b[?2004l\r"]
[313.415152, "o", "\u001b[?2004h"]
[313.415168, "o", "> "]
[313.415223, "o", "    xs, ys = shift[m], y[m]\r\n\u001b[?2004l\r"]
[313.415248, "o", "\u001b[?2004h"]
[313.415271, "o", "> "]
[313.415298, "o", "    off0 = ys.min()\r\n\u001b[?2004l\r"]
[313.415325, "o", "\u001b[?2004h> "]
[313.415392, "o", "    amp0 = ys.max()-off0\r\n\u001b[?2004l\r"]
[313.415413, "o", "\u001b[?2004h"]
[313.415442, "o", "> "]
[313.415504, "o", "    p0 = [x0g, 15, amp0, off0]\r\n\u001b[?2004l\r"]
[313.415531, "o", "\u001b[?2004h> "]
[313.415665, "o", "    popt, pcov = curve_fit(lorentz, xs, ys, p0=p0)\r\n\u001b[?2004l\r"]
[313.415698, "o", "\u001b[?2004h> "]
[313.415776, "o", "    perr = np.sqrt(np.diag(pcov))\r\n\u001b[?2004l\r"]
[313.415801, "o", "\u001b[?2004h> "]
[313.415947, "o", "    print('fit:', popt, 'err:', perr, 'npts:', len(xs))\r\n\u001b[?2004l\r"]
[313.415977, "o", "\u001b[?2004h> "]
[313.416019, "o", "    return popt\r\n\u001b[?2004l\r"]
[313.416041, "o", "\u001b[?2004h> "]
[313.416078, "o", "\r\n\u001b[?2004l\r"]
[313.416112, "o", "\u001b[?2004h> "]
[313.416159, "o", "gG = fitpeak(1500, 1660, 1580)\r\n\u001b[?2004l\r"]
[313.41619, "o", "\u001b[?2004h> "]
[313.416271, "o", "g2D = fitpeak(2550, 2800, 2670)\r\n\u001b[?2004l\r"]
[313.416298, "o", "\u001b[?2004h"]
[313.416322, "o", "> "]
[313.416346, "o", "res = {\r\n\u001b[?2004l\r"]
[313.416375, "o", "\u001b[?2004h> "]
[313.416626, "o", "  'G': {'x0': float(gG[0]), 'gamma': float(abs(gG[1])), 'amplitude': float(gG[2]), 'offset': float(gG[3])},\r\n\u001b[?2004l\r"]
[313.416649, "o", "\u001b[?2004h"]
[313.416673, "o", "> "]
[313.416943, "o", "  '2D': {'x0': float(g2D[0]), 'gamma': float(abs(g2D[1])), 'amplitude': float(g2D[2]), 'offset': float(g2D[3])}\r\n\u001b[?2004l\r"]
[313.416968, "o", "\u001b[?2004h"]
[313.416993, "o", "> }\r\n\u001b[?2004l\r"]
[313.417018, "o", "\u001b[?2004h> "]
[313.417117, "o", "with open('/app/results.json','w') as f:\r\n"]
[313.417139, "o", "\u001b[?2004l\r"]
[313.417163, "o", "\u001b[?2004h> "]
[313.417231, "o", "    json.dump(res, f, indent=2)\r\n\u001b[?2004l\r"]
[313.417263, "o", "\u001b[?2004h> "]
[313.417355, "o", "print(json.dumps(res, indent=2))\r\n\u001b[?2004l\r"]
[313.417378, "o", "\u001b[?2004h"]
[313.417401, "o", "> EOF\r\n\u001b[?2004l\r"]
[313.418625, "o", "\u001b[?2004h"]
[313.418653, "o", "root@157a56ea-3acd-478c-aec0-66971ff88c54:/app# "]
[313.418691, "o", "python3 /app/fit.py\r\n\u001b[?2004l\r"]
