[314.215503, "o", "fit: [ 2670.09514215    17.85809373 12382.32659252  1131.74000496] err: [  0.17127019   0.31162085 119.89540384  45.41890888] npts: 131\r\n"]
[314.215733, "o", "{\r\n  \"G\": {\r\n    \"x0\": 1580.330946860035,\r\n    \"gamma\": 8.54226319045122,\r\n    \"amplitude\": 8316.722838086347,\r\n    \"offset\": 5732.823920438623\r\n  },\r\n  \"2D\": {\r\n    \"x0\": 2670.0951421531336,\r\n    \"gamma\": 17.858093727377675,\r\n    \"amplitude\": 12382.326592515667,\r\n    \"offset\": 1131.7400049592363\r\n  }\r\n}\r\n"]
[314.251311, "o", "\u001b[?2004hroot@157a56ea-3acd-478c-aec0-66971ff88c54:/app# "]
[339.453328, "i", "cat /app/results.json\n"]
[339.453437, "o", "cat /app/results.json\r\n\u001b[?2004l\r"]
