[140.834049, "i", "cat > /app/inspect.py << 'EOF'\nimport numpy as np\ndata = np.loadtxt('/app/graphene.dat', converters={0: lambda s: float(s.decode().replace(',','.')) if isinstance(s,bytes) else float(s.replace(',','.')), 1: lambda s: float(s.decode().replace(',','.')) if isinstance(s,bytes) else float(s.replace(',','.'))})\nx, y = data[:,0], data[:,1]\nprint('x range', x.min(), x.max(), 'n', len(x))\nfrom scipy.signal import find_peaks\n# sort ascending\nidx = np.argsort(x)\nx, y = x[idx], y[idx]\npeaks, props = find_peaks(y, prominence=2000)\nfor p in peaks:\n    print('peak at x=%.2f y=%.1f' % (x[p], y[p]))\nEOF\npython3 /app/inspect.py\n"]
