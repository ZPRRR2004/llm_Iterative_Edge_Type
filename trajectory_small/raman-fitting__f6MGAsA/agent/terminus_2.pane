[?2004hroot@157a56ea-3acd-478c-aec0-66971ff88c54:/app# cat > /app/fit.py << 'EOF'
[?2004l[?2004h> import numpy as np, json
[?2004l[?2004h> from scipy.optimize import curve_fit
[?2004l[?2004h> conv = lambda s: float(s.replace(',','.'))
[?2004l[?2004h> data = np.loadtxt('/app/graphene.dat', converters={0:conv,1:conv}, encoding=None)
[?2004l[?2004h> shift = 1e7/data[:,0]
[?2004l[?2004h> y = data[:,1]
[?2004l[?2004h> idx = np.argsort(shift)
[?2004l[?2004h> shift, y = shift[idx], y[idx]
[?2004l[?2004h> 
[?2004l[?2004h> def lorentz(x, x0, gamma, amplitude, offset):
[?2004l[?2004h>     return offset + amplitude * gamma**2 / ((x-x0)**2 + gamma**2)
[?2004l[?2004h> 
[?2004l[?2004h> def fitpeak(lo, hi, x0g):
[?2004l[?2004h>     m = (shift>=lo)&(shift<=hi)
[?2004l[?2004h>     xs, ys = shift[m], y[m]
[?2004l[?2004h>     off0 = ys.min()
[?2004l[?2004h>     amp0 = ys.max()-off0
[?2004l[?2004h>     p0 = [x0g, 15, amp0, off0]
[?2004l[?2004h>     popt, pcov = curve_fit(lorentz, xs, ys, p0=p0)
[?2004l[?2004h>     perr = np.sqrt(np.diag(pcov))
[?2004l[?2004h>     print('fit:', popt, 'err:', perr, 'npts:', len(xs))
[?2004l[?2004h>     return popt
[?2004l[?2004h> 
[?2004l[?2004h> gG = fitpeak(1500, 1660, 1580)
[?2004l[?2004h> g2D = fitpeak(2550, 2800, 2670)
[?2004l[?2004h> res = {
[?2004l[?2004h>   'G': {'x0': float(gG[0]), 'gamma': float(abs(gG[1])), 'amplitude': float(gG[2]), 'offset': float(gG[3])},
[?2004l[?2004h>   '2D': {'x0': float(g2D[0]), 'gamma': float(abs(g2D[1])), 'amplitude': float(g2D[2]), 'offset': float(g2D[3])}
[?2004l[?2004h> }
[?2004l[?2004h> with open('/app/results.json','w') as f:
[?2004l[?2004h>     json.dump(res, f, indent=2)
