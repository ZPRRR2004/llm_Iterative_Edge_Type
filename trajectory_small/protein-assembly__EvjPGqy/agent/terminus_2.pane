def gc(s):return sum(c in 'GC' for c in s)
bad=0
mn=100;mx=0
for i in range(len(nt)-49):
    g=gc(nt[i:i+50])
    mn=min(mn,g);mx=max(mx,g)
    if g<15 or g>35:bad+=1
print('bad windows',bad,'min%',mn*2,'max%',mx*2)
