[840.264066, "o", "    g=gc(nt[i:i+50])\r\n\u001b[?2004l\r"]
[840.264106, "o", "\u001b[?2004h> "]
[840.264188, "o", "    mn=min(mn,g);mx=max(mx,g)\r\n\u001b[?2004l\r"]
[840.264221, "o", "\u001b[?2004h> "]
[840.264287, "o", "    if g<15 or g>35:bad+=1\r\n\u001b[?2004l\r"]
[840.26432, "o", "\u001b[?2004h> "]
[840.264438, "o", "print('bad windows',bad,'min%',mn*2,'max%',mx*2)\r\n\u001b[?2004l\r"]
[840.264471, "o", "\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r"]
[840.266096, "o", "\u001b[?2004hroot@979b2f2f-944a-4f19-b2c3-46febda074e7:/app# "]
[840.26614, "o", "python3 verify.py\r\n\u001b[?2004l\r"]
