[715.188365, "i", "cat > build.py << 'PYEOF'\nimport re\n\ndef readseq(f):\n    s=open(f).read().split('\\n')\n    seq=''.join(l for l in s if not l.startswith('>'))\n    return seq.strip()\n\n# DHFR from plasmid translation\ndhfr=\"MISLIAALAVDRVIGMENAMPWNLPADLAWFKRNTLNKPVIMGRHTWESIGRPLPGRKNIILSSQPGTDDRVTWVKSVDEAIAACGDVPEIMVIGGGRVYEQFLPKAQKLYLTHIDAEVEGDTHFPDYEPDDWESVFSEFHDADAQNSHSYCFEILERR\"\n\ndonor=readseq('pdb_fasta/5WJ2.fasta')\nacceptor=readseq('pdb_fasta/2H5Q.fasta')\nmolbind=readseq('pdb_fasta/3KZY.fasta')\nflag=\"DYKDDDDK\"\n\nprint('donor raw',donor)\nprint('acceptor raw',acceptor)\nprint('molbind raw',molbind)\nprint('Xcount donor',donor.count('X'),'acc',acceptor.count('X'),'mol',molbind.count('X'))\n\n# expand chromophore X\ndonor=donor.replace('X','GYG')\nacceptor=acceptor.replace('X','MYG')\n\ndef rmM(s):\n    return s[1:] if s.startswith('M') else s\n\ndonor=rmM(donor)\nacceptor=rmM(acceptor)\nmolbind=rmM(molbind)\ndhfr=rmM(dhfr)\nflag=rmM(flag)\n\nfor n,s in [('flag',flag),('donor',donor),('dhfr',dhfr),('acceptor',acceptor),('molbind',molbind)]:\n    p"]
[715.188395, "i", "rint(n,len(s),s[:15],'...',s[-10:])\n\nlinker='GSGSGSGSGS'  # 10 aa\nparts=[flag,donor,dhfr,acceptor,molbind]\nprotein=linker.join(parts)\nprint('total protein len',len(protein))\nprint('approx nt',len(protein)*3)\nopen('protein.txt','w').write(protein)\nPYEOF\npython3 build.py\n"]
