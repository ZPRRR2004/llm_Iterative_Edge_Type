[428.511667, "i", "cat > /app/ars.R << 'EOF'\n###############################################################################\n##  ars.R -- Adaptive Rejection Sampling (Gilks & Wild, 1992, JRSS-C 41:337)\n##\n##  Main user-facing function:\n##      ars(density_function, domain, n)\n##\n##  Formal test suite:\n##      test()\n###############################################################################\n\n## ---------------------------------------------------------------------------\n## 1. Input validation\n## ---------------------------------------------------------------------------\nvalidate_inputs <- function(density_function, domain, n) {\n  if (!is.function(density_function))\n    stop(\"ars: 'density_function' must be a function returning (possibly unnormalized) density values\")\n  if (!is.numeric(n) || length(n) != 1 || is.na(n) || n <= 0 || n != floor(n))\n    stop(\"ars: 'n' must be a single positive integer\")\n  if (!is.numeric(domain) || length(domain) != 2 || any(is.na(domain)))\n    stop(\"ars: 'domain' must be a numeric vector of length 2, e.g. c(-Inf, Inf)\")\n  if (domain[1] >= domain[2])\n    stop(\"ars: invalid domain: domain[1] must be strictly less than domain[2]\")\n  invisible(TRUE)\n}\n\n## ---------------------------------------------------------------------------\n## 2. Log-density and its numerical derivative\n## ---------------------------------------------------------------------------\nmake_h <- function(density_function) {\n  function(x) {\n    fx <- density_function(x)\n    if (!is.numeric(fx) || length(fx) != length(x))\n      stop(\"ars: 'density_function' must be vectorized and return one numeric value per input\")\n    if (any(is.na(fx)) || any(fx < 0))\n      stop(\"ars: 'density_function' returned NA/NaN or negative values\")\n    log(fx)\n  }\n}\n\nh_prime <- function(h, x, eps = 1e-6) {\n  (h(x + eps) - h(x - eps)) / (2 * eps)\n}\n\n## ---------------------------------------------------------------------------\n## 3. Log-concavity check: slopes of log-density must be non-increasing in x\n## ---------------------------------------------------------------------------\ncheck_log_concave <- function(hpx, tol = 1e-5) {\n  if (any(diff(hpx) > tol))\n    stop(\"ars: density is not log-concave (slope of log-density increased between abscissae)\")\n  invisible(TRUE)\n}\n\n## ---------------------------------------------------------------------------\n## 4. Hull construction (upper tangent hull and lower chord squeeze)\n## ---------------------------------------------------------------------------\ncompute_z <- function(state, domain) {\n  x <- state$x; hx <- state$hx; hp <- state$hpx\n  k <- length(x)\n  if (k < 2) return(c(domain[1], domain[2]))\n  den <- hp[-k] - hp[-1]\n  num <- hx[-1] - hx[-k] - x[-1] * hp[-1] + x[-k] * hp[-k]\n  z <- ifelse(abs(den) < 1e-8, (x[-k] + x[-1]) / 2, num / den)\n  ## for a log-concave density z[j] must lie in [x[j], x[j+1]]; clamp for safety\n  z <- pmin(pmax(z, x[-k]), x[-1])\n  c(domain[1], z, domain[2])\n}\n\neval_upper <- function(state, xs) {\n  j <- findInterval(xs, state$z, all.inside = TRUE)\n  state$hx[j] + (xs - state$x[j]) * state$hpx[j]\n}\n\neval_lower <- function(state, xs) {\n  x <- state$x; hx <- state$hx\n  k <- length(x)\n  out <- rep(-Inf, length(xs))\n  inside <- xs >= x[1] & xs <= x[k]\n  if (any(inside)) {\n    j <- findInterval(xs[inside], x, all.inside = TRUE)\n    out[inside] <- (hx[j] * (x[j + 1] - xs[inside]) +\n                    hx[j + 1] * (xs[inside] - x[j])) / (x[j + 1] - x[j])\n  }\n  out\n}\n\n## ---------------------------------------------------------------------------\n## 5. Sampling from the piecewise-exponential upper hull (inverse CDF)\n## ---------------------------------------------------------------------------\nsample_upper <- function(state) {\n  x <- state$x; hx <- state$hx; hp <- state$hpx; z <- state$z\n  k <- length(x)\n  m <- max(hx)\n  zl <- z[1:k]; zr <- z[2:(k + 1)]\n  areas <- numeric(k)\n  for (j in 1:k) {\n    if (abs(hp[j]) < 1e-10) {\n      areas[j] <- exp(hx[j] - m) * (zr[j] - zl[j])\n    } else {\n      el <- if (is.finite(zl[j])) exp(hp[j] * (zl[j] - x[j])) else if (hp[j] > 0) 0 else Inf\n      er <- if (is.finite(zr[j])) e"]
[428.511958, "i", "xp(hp[j] * (zr[j] - x[j])) else if (hp[j] < 0) 0 else Inf\n      areas[j] <- exp(hx[j] - m) * (er - el) / hp[j]\n    }\n  }\n  if (any(!is.finite(areas)) || sum(areas) <= 0)\n    stop(\"ars: upper hull is not integrable; the density may be improper or non-log-concave\")\n  j <- if (k == 1) 1 else sample.int(k, 1, prob = areas)\n  u <- runif(1)\n  if (abs(hp[j]) < 1e-10) {\n    zl[j] + u * (zr[j] - zl[j])\n  } else {\n    el <- if (is.finite(zl[j])) exp(hp[j] * (zl[j] - x[j])) else 0\n    er <- if (is.finite(zr[j])) exp(hp[j] * (zr[j] - x[j])) else 0\n    x[j] + log(el + u * (er - el)) / hp[j]\n  }\n}\n\n## ---------------------------------------------------------------------------\n## 6. Updating the state with a newly evaluated abscissa\n## ---------------------------------------------------------------------------\nupdate_state <- function(state, xnew, hnew, hpnew, domain, max_points = 50) {\n  if (!is.finite(xnew) || !is.finite(hnew) || !is.finite(hpnew)) return(state)\n  if (length(state$x) >= max_points) return(state)\n  ord <- order(c(state$x, xnew))\n  x   <- c(state$x,   xnew)[ord]\n  hx  <- c(state$hx,  hnew)[ord]\n  hpx <- c(state$hpx, hpnew)[ord]\n  check_log_concave(hpx)\n  new_state <- list(x = x, hx = hx, hpx = hpx)\n  new_state$z <- compute_z(new_state, domain)\n  new_state\n}\n\n## ---------------------------------------------------------------------------\n## 7. Initialization of the abscissae\n## ---------------------------------------------------------------------------\ninit_state <- function(h, domain, k = 6) {\n  lower <- domain[1]; upper <- domain[2]\n  delta <- 1e-4\n  lo <- if (is.finite(lower)) lower + delta * max(1, abs(lower)) else NA\n  hi <- if (is.finite(upper)) upper - delta * max(1, abs(upper)) else NA\n  if (!is.finite(upper)) {\n    hi <- if (is.finite(lower)) lo + 1 else 1\n    ok <- FALSE\n    for (i in 1:60) {\n      d <- suppressWarnings(tryCatch(h_prime(h, hi), error = function(e) NA))\n      if (is.finite(d) && d < 0) { ok <- TRUE; break }\n      hi <- abs(hi) * 2 + 1\n    }\n    if (!ok) stop(\"ars: could not find a starting point with negative log-density slope in the right tail; density may be improper on this domain\")\n  }\n  if (!is.finite(lower)) {\n    lo <- min(-1, hi - 1)\n    ok <- FALSE\n    for (i in 1:60) {\n      d <- suppressWarnings(tryCatch(h_prime(h, lo), error = function(e) NA))\n      if (is.finite(d) && d > 0) { ok <- TRUE; break }\n      lo <- -(abs(lo) * 2 + 1)\n    }\n    if (!ok) stop(\"ars: could not find a starting point with positive log-density slope in the left tail; density may be improper on this domain\")\n  }\n  if (!(lo < hi)) stop(\"ars: failed to initialize abscissae (lo >= hi)\")\n  xs  <- seq(lo, hi, length.out = k)\n  hx  <- suppressWarnings(h(xs))\n  hpx <- suppressWarnings(h_prime(h, xs))\n  keep <- is.finite(hx) & is.finite(hpx)\n  xs <- xs[keep]; hx <- hx[keep]; hpx <- hpx[keep]\n  if (length(xs) < 2)\n    stop(\"ars: could not find at least two valid starting abscissae; check the density and the domain\")\n  check_log_concave(hpx)\n  if (!is.finite(lower) && hpx[1] <= 0)\n    stop(\"ars: initialization failed: leftmost slope must be positive when the domain is unbounded below\")\n  if (!is.finite(upper) && hpx[length(hpx)] >= 0)\n    stop(\"ars: initialization failed: rightmost slope must be negative when the domain is unbounded above\")\n  state <- list(x = xs, hx = hx, hpx = hpx)\n  state$z <- compute_z(state, domain)\n  state\n}\n\n## ---------------------------------------------------------------------------\n## 8. Main sampler\n## ---------------------------------------------------------------------------\nars <- function(density_function, domain, n = 1000) {\n  validate_inputs(density_function, domain, n)\n  h <- make_h(density_function)\n  state <- init_state(h, domain)\n  samples <- numeric(n)\n  n_accept <- 0\n  tol_violation <- 1e-3\n  max_iter <- max(10000, 200 * n)\n  iter <- 0\n  while (n_accept < n) {\n    iter <- iter + 1\n    if (iter > max_iter)\n      stop(\"ars: maximum number of iterations exceeded; sampling failed\")\n    xstar <- sample_upper(state)\n    if (!is.finite(xstar) || xstar < domain[1] || xstar > domain[2]) next"]
[428.512106, "i", "\n    w  <- runif(1)\n    ux <- eval_upper(state, xstar)\n    lx <- eval_lower(state, xstar)\n    if (lx > ux + tol_violation)\n      stop(\"ars: non-log-concavity detected (squeeze function exceeds the upper hull)\")\n    if (w <= exp(lx - ux)) {\n      ## accepted via squeeze test -- no density evaluation needed\n      n_accept <- n_accept + 1\n      samples[n_accept] <- xstar\n    } else {\n      hxs <- h(xstar)\n      if (is.finite(hxs) && hxs > ux + tol_violation)\n        stop(\"ars: non-log-concavity detected (log-density exceeds the upper hull)\")\n      if (w <= exp(hxs - ux)) {\n        n_accept <- n_accept + 1\n        samples[n_accept] <- xstar\n      }\n      hps <- suppressWarnings(tryCatch(h_prime(h, xstar), error = function(e) NA))\n      state <- update_state(state, xstar, hxs, hps, domain)\n    }\n  }\n  samples\n}\n\n## ---------------------------------------------------------------------------\n## 9. Formal test suite\n## ---------------------------------------------------------------------------\ntest <- function() {\n  cat(\"============================================================\\n\")\n  cat(\" Adaptive Rejection Sampler (Gilks & Wild 1992) test suite\\n\")\n  cat(\"============================================================\\n\")\n  set.seed(20240131)\n  all_pass <- TRUE\n\n  cat(\"\\n[1] Sampling 5000 draws from N(0,1) via ars(dnorm, c(-Inf, Inf)) ...\\n\")\n  s1 <- ars(dnorm, c(-Inf, Inf), n = 5000)\n  m1 <- mean(s1); sd1 <- sd(s1)\n  ks1 <- suppressWarnings(ks.test(s1, \"pnorm\")$p.value)\n  p1 <- abs(m1) < 0.1 && abs(sd1 - 1) < 0.1 && ks1 > 0.005\n  cat(sprintf(\"    expected mean = 0, sd = 1; Kolmogorov-Smirnov p-value = %.4f\\n\", ks1))\n  cat(sprintf(\"NORMAL_TEST: %s (mean=%.4f, sd=%.4f)\\n\", if (p1) \"PASS\" else \"FAIL\", m1, sd1))\n  write(s1, file = \"/app/normal_samples.txt\", ncolumns = 1)\n  cat(\"    samples saved to /app/normal_samples.txt\\n\")\n  all_pass <- all_pass && p1\n\n  cat(\"\\n[2] Sampling 5000 draws from Exp(1) via ars(dexp, c(0, Inf)) ...\\n\")\n  s2 <- ars(dexp, c(0, Inf), n = 5000)\n  m2 <- mean(s2); sd2 <- sd(s2)\n  ks2 <- suppressWarnings(ks.test(s2, \"pexp\")$p.value)\n  p2 <- abs(m2 - 1) < 0.1 && abs(sd2 - 1) < 0.12 && ks2 > 0.005\n  cat(sprintf(\"    expected mean = 1, sd = 1; Kolmogorov-Smirnov p-value = %.4f\\n\", ks2))\n  cat(sprintf(\"EXPONENTIAL_TEST: %s (mean=%.4f, sd=%.4f)\\n\", if (p2) \"PASS\" else \"FAIL\", m2, sd2))\n  write(s2, file = \"/app/exponential_samples.txt\", ncolumns = 1)\n  cat(\"    samples saved to /app/exponential_samples.txt\\n\")\n  all_pass <- all_pass && p2\n\n  cat(\"\\n[3] Sampling 5000 draws from Gamma(shape=3) on (0, Inf) ...\\n\")\n  s3 <- ars(function(x) dgamma(x, shape = 3), c(0, Inf), n = 5000)\n  m3 <- mean(s3); sd3 <- sd(s3)\n  ks3 <- suppressWarnings(ks.test(s3, \"pgamma\", shape = 3)$p.value)\n  p3 <- abs(m3 - 3) < 0.15 && abs(sd3 - sqrt(3)) < 0.15 && ks3 > 0.005\n  cat(sprintf(\"    expected mean = 3, sd = %.4f; KS p-value = %.4f\\n\", sqrt(3), ks3))\n  cat(sprintf(\"GAMMA_TEST: %s (mean=%.4f, sd=%.4f)\\n\", if (p3) \"PASS\" else \"FAIL\", m3, sd3))\n  all_pass <- all_pass && p3\n\n  cat(\"\\n[4] Sampling 3000 draws from an *unnormalized* normal kernel exp(-x^2/2) ...\\n\")\n  s4 <- ars(function(x) exp(-x^2 / 2), c(-Inf, Inf), n = 3000)\n  m4 <- mean(s4); sd4 <- sd(s4)\n  p4 <- abs(m4) < 0.12 && abs(sd4 - 1) < 0.12\n  cat(sprintf(\"UNNORMALIZED_TEST: %s (mean=%.4f, sd=%.4f)\\n\", if (p4) \"PASS\" else \"FAIL\", m4, sd4))\n  all_pass <- all_pass && p4\n\n  cat(\"\\n[5] Module test: upper hull dominates log-density, lower hull is dominated ...\\n\")\n  hfun <- make_h(dnorm)\n  st <- init_state(hfun, c(-Inf, Inf))\n  xs <- seq(-3, 3, length.out = 201)\n  uv <- eval_upper(st, xs); lv <- eval_lower(st, xs); hv <- hfun(xs)\n  p5 <- all(uv >= hv - 1e-6) && all(lv <= hv + 1e-6)\n  cat(sprintf(\"HULL_TEST: %s (max(h-u)=%.2e, max(l-h)=%.2e)\\n\",\n              if (p5) \"PASS\" else \"FAIL\", max(hv - uv), max(lv - hv)))\n  all_pass <- all_pass && p5\n\n  cat(\"\\n[6] Input validation: invalid inputs must raise errors ...\\n\")\n  e1 <- inherits(tryCatch(ars(dnorm, c(-Inf, Inf), n = -5), error = function(e) e), \"error\")\n  cat(sprintf(\"INVALID_N_TEST: %s (negative sample count rejected)\\n\", if (e1)"]
[428.512161, "i", " \"PASS\" else \"FAIL\"))\n  e2 <- inherits(tryCatch(ars(dnorm, c(2, -2), n = 100), error = function(e) e), \"error\")\n  cat(sprintf(\"INVALID_DOMAIN_TEST: %s (reversed domain rejected)\\n\", if (e2) \"PASS\" else \"FAIL\"))\n  e3 <- inherits(tryCatch(ars(\"not_a_function\", c(-Inf, Inf), n = 100), error = function(e) e), \"error\")\n  cat(sprintf(\"INVALID_DENSITY_TEST: %s (non-function density rejected)\\n\", if (e3) \"PASS\" else \"FAIL\"))\n  all_pass <- all_pass && e1 && e2 && e3\n\n  cat(\"\\n[7] Non-log-concave densities must be detected during sampling ...\\n\")\n  e4 <- tryCatch({ ars(dcauchy, c(-Inf, Inf), n = 2000); NULL }, error = function(e) e)\n  ok4 <- inherits(e4, \"error\")\n  if (ok4) cat(\"    caught expected error: \", conditionMessage(e4), \"\\n\", sep = \"\")\n  cat(sprintf(\"NON_LOG_CONCAVE_CAUCHY_TEST: %s\\n\", if (ok4) \"PASS\" else \"FAIL\"))\n  mix <- function(x) 0.5 * dnorm(x, -3) + 0.5 * dnorm(x, 3)\n  e5 <- tryCatch({ ars(mix, c(-Inf, Inf), n = 2000); NULL }, error = function(e) e)\n  ok5 <- inherits(e5, \"error\")\n  if (ok5) cat(\"    caught expected error: \", conditionMessage(e5), \"\\n\", sep = \"\")\n  cat(sprintf(\"NON_LOG_CONCAVE_MIXTURE_TEST: %s\\n\", if (ok5) \"PASS\" else \"FAIL\"))\n  all_pass <- all_pass && ok4 && ok5\n\n  cat(\"\\n============================================================\\n\")\n  cat(sprintf(\"OVERALL: %s\\n\", if (all_pass) \"ALL TESTS PASSED\" else \"SOME TESTS FAILED\"))\n  cat(\"============================================================\\n\")\n  invisible(all_pass)\n}\nEOF\n"]
