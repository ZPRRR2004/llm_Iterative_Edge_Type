[428.529936, "o", "## ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[428.529985, "o", "\u001b[?2004h> "]
[428.530578, "o", "## 3. Log-concavity check: slopes of log-density must be non-increasing in x\r\n\u001b[?2004l\r"]
[428.530639, "o", "\u001b[?2004h> "]
[428.53124, "o", "## ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[428.531303, "o", "\u001b[?2004h> "]
[428.53167, "o", "check_log_concave <- function(hpx, tol = 1e-5) {\r\n\u001b[?2004l\r"]
[428.531731, "o", "\u001b[?2004h> "]
[428.532016, "o", "  if (any(diff(hpx) > tol))\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.53207, "o", "> "]
[428.532744, "o", "    stop(\"ars: density is not log-concave (slope of log-density increased between abscissae)\")\r\n\u001b[?2004l\r"]
[428.532791, "o", "\u001b[?2004h> "]
[428.532967, "o", "  invisible(TRUE)\r\n\u001b[?2004l\r"]
[428.533016, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[428.53313, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[428.533178, "o", "\u001b[?2004h> "]
[428.533775, "o", "## ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[428.533822, "o", "\u001b[?2004h> "]
[428.534367, "o", "## 4. Hull construction (upper tangent hull and lower chord squeeze)\r\n\u001b[?2004l\r"]
[428.534414, "o", "\u001b[?2004h> "]
[428.53502, "o", "## ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[428.535066, "o", "\u001b[?2004h> "]
[428.535382, "o", "compute_z <- function(state, domain) {\r\n\u001b[?2004l\r"]
[428.535429, "o", "\u001b[?2004h> "]
[428.535812, "o", "  x <- state$x; hx <- state$hx; hp <- state$hpx\r\n\u001b[?2004l\r"]
[428.535858, "o", "\u001b[?2004h> "]
[428.53609, "o", "  k <- length(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[428.536429, "o", "  if (k < 2) return(c(domain[1], domain[2]))\r\n\u001b[?2004l\r"]
[428.536532, "o", "\u001b[?2004h> "]
[428.536683, "o", "  den <- hp[-k] - hp[-1]\r\n\u001b[?2004l\r"]
[428.536744, "o", "\u001b[?2004h> "]
[428.537247, "o", "  num <- hx[-1] - hx[-k] - x[-1] * hp[-1] + x[-k] * hp[-k]\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.537352, "o", "> "]
[428.537746, "o", "  z <- ifelse(abs(den) < 1e-8, (x[-k] + x[-1]) / 2, num / den)\r\n\u001b[?2004l\r"]
[428.537806, "o", "\u001b[?2004h> "]
[428.538412, "o", "  ## for a log-concave density z[j] must lie in [x[j], x[j+1]]; clamp for safety\r\n\u001b[?2004l\r"]
[428.53847, "o", "\u001b[?2004h> "]
[428.538764, "o", "  z <- pmin(pmax(z, x[-k]), x[-1])\r\n\u001b[?2004l\r"]
[428.538821, "o", "\u001b[?2004h> "]
[428.539064, "o", "  c(domain[1], z, domain[2])\r\n\u001b[?2004l\r"]
[428.539127, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[428.539191, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[428.539359, "o", "\u001b[?2004h> "]
[428.539527, "o", "eval_upper <- function(state, xs) {\r\n\u001b[?2004l\r"]
[428.539583, "o", "\u001b[?2004h> "]
[428.539963, "o", "  j <- findInterval(xs, state$z, all.inside = TRUE)\r\n\u001b[?2004l\r"]
[428.540019, "o", "\u001b[?2004h> "]
[428.540379, "o", "  state$hx[j] + (xs - state$x[j]) * state$hpx[j]\r\n\u001b[?2004l\r"]
[428.540461, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.540506, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[428.540599, "o", "> "]
[428.540815, "o", "eval_lower <- function(state, xs) {\r\n\u001b[?2004l\r"]
[428.540866, "o", "\u001b[?2004h> "]
[428.541109, "o", "  x <- state$x; hx <- state$hx\r\n\u001b[?2004l\r"]
[428.541186, "o", "\u001b[?2004h> "]
[428.541284, "o", "  k <- length(x)\r\n\u001b[?2004l\r"]
[428.541358, "o", "\u001b[?2004h> "]
[428.541564, "o", "  out <- rep(-Inf, length(xs))\r\n\u001b[?2004l\r"]
[428.541618, "o", "\u001b[?2004h> "]
[428.541876, "o", "  inside <- xs >= x[1] & xs <= x[k]\r\n\u001b[?2004l\r"]
[428.541961, "o", "\u001b[?2004h> "]
[428.542101, "o", "  if (any(inside)) {\r\n\u001b[?2004l\r"]
[428.542173, "o", "\u001b[?2004h> "]
[428.542558, "o", "    j <- findInterval(xs[inside], x, all.inside = TRUE)\r\n\u001b[?2004l\r"]
[428.54261, "o", "\u001b[?2004h> "]
[428.543002, "o", "    out[inside] <- (hx[j] * (x[j + 1] - xs[inside]) +\r\n\u001b[?2004l\r"]
[428.543078, "o", "\u001b[?2004h> "]
[428.543577, "o", "                    hx[j + 1] * (xs[inside] - x[j])) / (x[j + 1] - x[j])\r\n\u001b[?2004l\r"]
[428.543633, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[428.543685, "o", "\u001b[?2004h> "]
[428.543824, "o", "  out\r\n\u001b[?2004l\r\u001b[?2004h> }"]
[428.543908, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[428.543995, "o", "> "]
[428.544516, "o", "## ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[428.544573, "o", "\u001b[?2004h> "]
[428.545093, "o", "## 5. Sampling from the piecewise-exponential upper hull (inverse CDF)\r\n\u001b[?2004l\r"]
[428.545146, "o", "\u001b[?2004h> "]
[428.545709, "o", "## ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[428.545767, "o", "\u001b[?2004h> "]
[428.54603, "o", "sample_upper <- function(state) {\r\n\u001b[?2004l\r"]
[428.546103, "o", "\u001b[?2004h> "]
[428.546586, "o", "  x <- state$x; hx <- state$hx; hp <- state$hpx; z <- state$z\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.546693, "o", "> "]
[428.546774, "o", "  k <- length(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[428.546908, "o", "  m <- max(hx)\r\n\u001b[?2004l\r"]
[428.546983, "o", "\u001b[?2004h> "]
[428.547221, "o", "  zl <- z[1:k]; zr <- z[2:(k + 1)]\r\n\u001b[?2004l\r"]
[428.547307, "o", "\u001b[?2004h> "]
[428.547485, "o", "  areas <- numeric(k)\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.547574, "o", "> "]
[428.547647, "o", "  for (j in 1:k) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.547696, "o", "> "]
[428.547911, "o", "    if (abs(hp[j]) < 1e-10) {\r\n\u001b[?2004l\r"]
[428.547959, "o", "\u001b[?2004h> "]
[428.548335, "o", "      areas[j] <- exp(hx[j] - m) * (zr[j] - zl[j])\r\n\u001b[?2004l\r"]
[428.548381, "o", "\u001b[?2004h> "]
[428.548481, "o", "    } else {\r\n\u001b[?2004l\r"]
[428.548525, "o", "\u001b[?2004h> "]
[428.549209, "o", "      el <- if (is.finite(zl[j])) exp(hp[j] * (zl[j] - x[j])) else if (hp[j] > 0) 0 else Inf\r\n\u001b[?2004l\r"]
[428.549257, "o", "\u001b[?2004h> "]
[428.549938, "o", "      er <- if (is.finite(zr[j])) exp(hp[j] * (zr[j] - x[j])) else if (hp[j] < 0) 0 else Inf\r\n\u001b[?2004l\r"]
[428.549987, "o", "\u001b[?2004h> "]
[428.550369, "o", "      areas[j] <- exp(hx[j] - m) * (er - el) / hp[j]\r\n\u001b[?2004l\r"]
[428.550418, "o", "\u001b[?2004h> "]
[428.550532, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[428.550583, "o", "\u001b[?2004h> "]
[428.550966, "o", "  if (any(!is.finite(areas)) || sum(areas) <= 0)\r\n\u001b[?2004l\r"]
[428.551016, "o", "\u001b[?2004h> "]
[428.551701, "o", "    stop(\"ars: upper hull is not integrable; the density may be improper or non-log-concave\")\r\n\u001b[?2004l\r"]
[428.551742, "o", "\u001b[?2004h> "]
[428.580618, "o", "  j <- if (k == 1) 1 else sample.int(k, 1, prob = areas)\r\n\u001b[?2004l\r"]
[428.580706, "o", "\u001b[?2004h> "]
[428.580788, "o", "  u <- runif(1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.580833, "o", "> "]
[428.581048, "o", "  if (abs(hp[j]) < 1e-10) {\r\n\u001b[?2004l\r"]
[428.581094, "o", "\u001b[?2004h> "]
[428.58133, "o", "    zl[j] + u * (zr[j] - zl[j])\r\n\u001b[?2004l\r"]
[428.581375, "o", "\u001b[?2004h> "]
[428.581466, "o", "  } else {\r\n\u001b[?2004l\r"]
[428.581511, "o", "\u001b[?2004h> "]
[428.582005, "o", "    el <- if (is.finite(zl[j])) exp(hp[j] * (zl[j] - x[j])) else 0\r\n\u001b[?2004l\r"]
[428.582051, "o", "\u001b[?2004h> "]
[428.582537, "o", "    er <- if (is.finite(zr[j])) exp(hp[j] * (zr[j] - x[j])) else 0\r\n\u001b[?2004l\r"]
[428.582583, "o", "\u001b[?2004h> "]
[428.582906, "o", "    x[j] + log(el + u * (er - el)) / hp[j]\r\n\u001b[?2004l\r"]
[428.582952, "o", "\u001b[?2004h>   }"]
[428.583049, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[428.583095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[428.583182, "o", "\u001b[?2004h> "]
[428.583735, "o", "## ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[428.583785, "o", "\u001b[?2004h> "]
[428.584205, "o", "## 6. Updating the state with a newly evaluated abscissa\r\n\u001b[?2004l\r"]
[428.584253, "o", "\u001b[?2004h> "]
[428.584815, "o", "## ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[428.584863, "o", "\u001b[?2004h> "]
[428.585435, "o", "update_state <- function(state, xnew, hnew, hpnew, domain, max_points = 50) {\r\n\u001b[?2004l\r"]
[428.585485, "o", "\u001b[?2004h> "]
[428.586068, "o", "  if (!is.finite(xnew) || !is.finite(hnew) || !is.finite(hpnew)) return(state)\r\n\u001b[?2004l\r"]
[428.586116, "o", "\u001b[?2004h> "]
[428.586475, "o", "  if (length(state$x) >= max_points) return(state)\r\n\u001b[?2004l\r"]
[428.586522, "o", "\u001b[?2004h> "]
[428.586768, "o", "  ord <- order(c(state$x, xnew))\r\n\u001b[?2004l\r"]
[428.586817, "o", "\u001b[?2004h> "]
[428.587077, "o", "  x   <- c(state$x,   xnew)[ord]\r\n\u001b[?2004l\r"]
[428.587125, "o", "\u001b[?2004h> "]
[428.587367, "o", "  hx  <- c(state$hx,  hnew)[ord]\r\n\u001b[?2004l\r"]
[428.587414, "o", "\u001b[?2004h> "]
[428.587668, "o", "  hpx <- c(state$hpx, hpnew)[ord]\r\n\u001b[?2004l\r"]
[428.587715, "o", "\u001b[?2004h> "]
[428.58791, "o", "  check_log_concave(hpx)\r\n\u001b[?2004l\r"]
[428.587957, "o", "\u001b[?2004h> "]
[428.588298, "o", "  new_state <- list(x = x, hx = hx, hpx = hpx)\r\n\u001b[?2004l\r"]
[428.588346, "o", "\u001b[?2004h> "]
[428.588685, "o", "  new_state$z <- compute_z(new_state, domain)\r\n\u001b[?2004l\r"]
[428.588732, "o", "\u001b[?2004h> "]
[428.588824, "o", "  new_state\r\n\u001b[?2004l\r"]
[428.588873, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[428.588934, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[428.589049, "o", "\u001b[?2004h> "]
[428.589573, "o", "## ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[428.589622, "o", "\u001b[?2004h> "]
[428.589915, "o", "## 7. Initialization of the abscissae\r\n\u001b[?2004l\r"]
[428.589971, "o", "\u001b[?2004h> "]
[428.590574, "o", "## ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[428.590619, "o", "\u001b[?2004h> "]
[428.590987, "o", "init_state <- function(h, domain, k = 6) {\r\n\u001b[?2004l\r"]
[428.591033, "o", "\u001b[?2004h> "]
[428.591368, "o", "  lower <- domain[1]; upper <- domain[2]\r\n\u001b[?2004l\r"]
[428.591414, "o", "\u001b[?2004h> "]
[428.591572, "o", "  delta <- 1e-4\r\n\u001b[?2004l\r"]
[428.591617, "o", "\u001b[?2004h> "]
[428.592191, "o", "  lo <- if (is.finite(lower)) lower + delta * max(1, abs(lower)) else NA\r\n\u001b[?2004l\r"]
[428.592236, "o", "\u001b[?2004h> "]
[428.592798, "o", "  hi <- if (is.finite(upper)) upper - delta * max(1, abs(upper)) else NA\r\n\u001b[?2004l\r"]
[428.592844, "o", "\u001b[?2004h> "]
[428.593088, "o", "  if (!is.finite(upper)) {\r\n\u001b[?2004l\r"]
[428.593133, "o", "\u001b[?2004h> "]
[428.593506, "o", "    hi <- if (is.finite(lower)) lo + 1 else 1\r\n\u001b[?2004l\r"]
[428.593551, "o", "\u001b[?2004h> "]
[428.593708, "o", "    ok <- FALSE\r\n\u001b[?2004l\r"]
[428.593756, "o", "\u001b[?2004h> "]
[428.593961, "o", "    for (i in 1:60) {\r\n\u001b[?2004l\r"]
[428.594007, "o", "\u001b[?2004h> "]
[428.594619, "o", "      d <- suppressWarnings(tryCatch(h_prime(h, hi), error = function(e) NA))\r\n\u001b[?2004l\r"]
[428.594664, "o", "\u001b[?2004h> "]
[428.595111, "o", "      if (is.finite(d) && d < 0) { ok <- TRUE; break }\r\n\u001b[?2004l\r"]
[428.595157, "o", "\u001b[?2004h> "]
[428.595405, "o", "      hi <- abs(hi) * 2 + 1\r\n\u001b[?2004l\r"]
[428.595451, "o", "\u001b[?2004h> "]
[428.595559, "o", "    }\r\n\u001b[?2004l\r"]
[428.595606, "o", "\u001b[?2004h> "]
[428.596732, "o", "    if (!ok) stop(\"ars: could not find a starting point with negative log-density slope in the right tail; density may be improper on this domain\")\r\n\u001b[?2004l\r"]
[428.596782, "o", "\u001b[?2004h> "]
[428.596906, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[428.597127, "o", "  if (!is.finite(lower)) {\r\n\u001b[?2004l\r"]
[428.597176, "o", "\u001b[?2004h> "]
[428.597403, "o", "    lo <- min(-1, hi - 1)\r\n\u001b[?2004l\r"]
[428.597453, "o", "\u001b[?2004h> "]
[428.597605, "o", "    ok <- FALSE\r\n\u001b[?2004l\r"]
[428.597654, "o", "\u001b[?2004h> "]
[428.597859, "o", "    for (i in 1:60) {\r\n\u001b[?2004l\r"]
[428.597919, "o", "\u001b[?2004h> "]
[428.598514, "o", "      d <- suppressWarnings(tryCatch(h_prime(h, lo), error = function(e) NA))\r\n\u001b[?2004l\r"]
[428.598564, "o", "\u001b[?2004h> "]
[428.599007, "o", "      if (is.finite(d) && d > 0) { ok <- TRUE; break }\r\n\u001b[?2004l\r"]
[428.599057, "o", "\u001b[?2004h> "]
[428.599313, "o", "      lo <- -(abs(lo) * 2 + 1)\r\n\u001b[?2004l\r"]
[428.599362, "o", "\u001b[?2004h> "]
[428.599465, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.599513, "o", "> "]
[428.60059, "o", "    if (!ok) stop(\"ars: could not find a starting point with positive log-density slope in the left tail; density may be improper on this domain\")\r\n\u001b[?2004l\r"]
[428.600641, "o", "\u001b[?2004h> "]
[428.600699, "o", "  }\r\n\u001b[?2004l\r"]
[428.600832, "o", "\u001b[?2004h> "]
[428.601331, "o", "  if (!(lo < hi)) stop(\"ars: failed to initialize abscissae (lo >= hi)\")\r\n\u001b[?2004l\r"]
[428.601377, "o", "\u001b[?2004h> "]
[428.601678, "o", "  xs  <- seq(lo, hi, length.out = k)\r\n\u001b[?2004l\r"]
[428.601724, "o", "\u001b[?2004h> "]
[428.602012, "o", "  hx  <- suppressWarnings(h(xs))\r\n\u001b[?2004l\r"]
[428.602058, "o", "\u001b[?2004h> "]
[428.60241, "o", "  hpx <- suppressWarnings(h_prime(h, xs))\r\n\u001b[?2004l\r"]
[428.602456, "o", "\u001b[?2004h> "]
[428.602786, "o", "  keep <- is.finite(hx) & is.finite(hpx)\r\n\u001b[?2004l\r"]
[428.602831, "o", "\u001b[?2004h> "]
[428.603252, "o", "  xs <- xs[keep]; hx <- hx[keep]; hpx <- hpx[keep]\r\n\u001b[?2004l\r"]
[428.603298, "o", "\u001b[?2004h> "]
[428.603496, "o", "  if (length(xs) < 2)\r\n\u001b[?2004l\r"]
[428.603542, "o", "\u001b[?2004h> "]
[428.604335, "o", "    stop(\"ars: could not find at least two valid starting abscissae; check the density and the domain\")\r\n\u001b[?2004l\r"]
[428.604381, "o", "\u001b[?2004h> "]
[428.604604, "o", "  check_log_concave(hpx)\r\n\u001b[?2004l\r"]
[428.604649, "o", "\u001b[?2004h> "]
[428.604988, "o", "  if (!is.finite(lower) && hpx[1] <= 0)\r\n\u001b[?2004l\r"]
[428.605035, "o", "\u001b[?2004h> "]
[428.605836, "o", "    stop(\"ars: initialization failed: leftmost slope must be positive when the domain is unbounded below\")\r\n\u001b[?2004l\r"]
[428.605883, "o", "\u001b[?2004h> "]
[428.606315, "o", "  if (!is.finite(upper) && hpx[length(hpx)] >= 0)\r\n\u001b[?2004l\r"]
[428.606412, "o", "\u001b[?2004h> "]
[428.607177, "o", "    stop(\"ars: initialization failed: rightmost slope must be negative when the domain is unbounded above\")\r\n\u001b[?2004l\r"]
[428.607239, "o", "\u001b[?2004h> "]
[428.607587, "o", "  state <- list(x = xs, hx = hx, hpx = hpx)\r\n\u001b[?2004l\r"]
[428.60765, "o", "\u001b[?2004h> "]
[428.607971, "o", "  state$z <- compute_z(state, domain)\r\n\u001b[?2004l\r"]
[428.60803, "o", "\u001b[?2004h> "]
[428.608119, "o", "  state\r\n\u001b[?2004l\r"]
[428.608183, "o", "\u001b[?2004h> }\r\n"]
[428.608319, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[428.608374, "o", "> "]
[428.608971, "o", "## ---------------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.60903, "o", "> "]
[428.60919, "o", "## 8. Main sampler\r\n\u001b[?2004l\r"]
[428.609248, "o", "\u001b[?2004h> "]
[428.609851, "o", "## ---------------------------------------------------------------------------\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.609915, "o", "> "]
[428.610328, "o", "ars <- function(density_function, domain, n = 1000) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.610386, "o", "> "]
[428.610756, "o", "  validate_inputs(density_function, domain, n)\r\n\u001b[?2004l\r"]
[428.610812, "o", "\u001b[?2004h> "]
[428.611092, "o", "  h <- make_h(density_function)\r\n\u001b[?2004l\r"]
[428.611151, "o", "\u001b[?2004h> "]
[428.611406, "o", "  state <- init_state(h, domain)\r\n\u001b[?2004l\r"]
[428.611456, "o", "\u001b[?2004h> "]
[428.611664, "o", "  samples <- numeric(n)\r\n\u001b[?2004l\r"]
[428.611714, "o", "\u001b[?2004h> "]
[428.611868, "o", "  n_accept <- 0\r\n\u001b[?2004l\r"]
[428.61196, "o", "\u001b[?2004h> "]
[428.612137, "o", "  tol_violation <- 1e-3\r\n\u001b[?2004l\r"]
[428.612186, "o", "\u001b[?2004h> "]
[428.612469, "o", "  max_iter <- max(10000, 200 * n)\r\n\u001b[?2004l\r"]
[428.612518, "o", "\u001b[?2004h> "]
[428.612643, "o", "  iter <- 0\r\n\u001b[?2004l\r"]
[428.612691, "o", "\u001b[?2004h> "]
[428.612917, "o", "  while (n_accept < n) {\r\n\u001b[?2004l\r"]
[428.612963, "o", "\u001b[?2004h> "]
[428.613168, "o", "    iter <- iter + 1\r\n\u001b[?2004l\r"]
[428.613217, "o", "\u001b[?2004h> "]
[428.613435, "o", "    if (iter > max_iter)\r\n\u001b[?2004l\r"]
[428.613483, "o", "\u001b[?2004h> "]
[428.61406, "o", "      stop(\"ars: maximum number of iterations exceeded; sampling failed\")\r\n\u001b[?2004l\r"]
[428.614108, "o", "\u001b[?2004h> "]
[428.614388, "o", "    xstar <- sample_upper(state)\r\n\u001b[?2004l\r"]
[428.614436, "o", "\u001b[?2004h> "]
[428.615016, "o", "    if (!is.finite(xstar) || xstar < domain[1] || xstar > domain[2]) next\r\n\u001b[?2004l\r"]
[428.615066, "o", "\u001b[?2004h> "]
[428.615239, "o", "    w  <- runif(1)\r\n\u001b[?2004l\r"]
[428.615287, "o", "\u001b[?2004h> "]
[428.615591, "o", "    ux <- eval_upper(state, xstar)\r\n\u001b[?2004l\r"]
[428.61564, "o", "\u001b[?2004h> "]
[428.615951, "o", "    lx <- eval_lower(state, xstar)\r\n\u001b[?2004l\r"]
[428.616004, "o", "\u001b[?2004h> "]
[428.616278, "o", "    if (lx > ux + tol_violation)\r\n\u001b[?2004l\r"]
[428.616327, "o", "\u001b[?2004h> "]
[428.617035, "o", "      stop(\"ars: non-log-concavity detected (squeeze function exceeds the upper hull)\")\r\n\u001b[?2004l\r"]
[428.617092, "o", "\u001b[?2004h> "]
[428.61734, "o", "    if (w <= exp(lx - ux)) {\r\n\u001b[?2004l\r"]
[428.61739, "o", "\u001b[?2004h> "]
[428.617911, "o", "      ## accepted via squeeze test -- no density evaluation needed\r\n\u001b[?2004l\r"]
[428.617966, "o", "\u001b[?2004h> "]
[428.618225, "o", "      n_accept <- n_accept + 1\r\n\u001b[?2004l\r"]
[428.618276, "o", "\u001b[?2004h> "]
[428.618546, "o", "      samples[n_accept] <- xstar\r\n\u001b[?2004l\r"]
[428.618595, "o", "\u001b[?2004h> "]
[428.618724, "o", "    } else {\r\n\u001b[?2004l\r"]
[428.618773, "o", "\u001b[?2004h> "]
[428.619046, "o", "      hxs <- h(xstar)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[428.619497, "o", "      if (is.finite(hxs) && hxs > ux + tol_violation)\r\n\u001b[?2004l\r"]
[428.619655, "o", "\u001b[?2004h> "]
[428.620203, "o", "        stop(\"ars: non-log-concavity detected (log-density exceeds the upper hull)\")\r\n\u001b[?2004l\r"]
[428.620256, "o", "\u001b[?2004h> "]
[428.62047, "o", "      if (w <= exp(hxs - ux)) {\r\n\u001b[?2004l\r"]
[428.620562, "o", "\u001b[?2004h> "]
[428.620813, "o", "        n_accept <- n_accept + 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.620945, "o", "> "]
[428.621088, "o", "        samples[n_accept] <- xstar\r\n\u001b[?2004l\r"]
[428.621156, "o", "\u001b[?2004h> "]
[428.621217, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.621375, "o", "> "]
[428.621841, "o", "      hps <- suppressWarnings(tryCatch(h_prime(h, xstar), error = function(e) NA))\r\n\u001b[?2004l\r"]
[428.621913, "o", "\u001b[?2004h> "]
[428.622339, "o", "      state <- update_state(state, xstar, hxs, hps, domain)\r\n\u001b[?2004l\r"]
[428.622401, "o", "\u001b[?2004h> "]
[428.622514, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[428.622574, "o", "\u001b[?2004h> "]
[428.622691, "o", "  samples\r\n\u001b[?2004l\r\u001b[?2004h> "]
[428.622751, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[428.622861, "o", "\u001b[?2004h> "]
[428.6234, "o", "## ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[428.623456, "o", "\u001b[?2004h> "]
[428.623624, "o", "## 9. Formal test suite\r\n\u001b[?2004l\r"]
[428.623681, "o", "\u001b[?2004h> "]
[428.624251, "o", "## ---------------------------------------------------------------------------\r\n\u001b[?2004l\r"]
[428.62431, "o", "\u001b[?2004h> "]
[428.624455, "o", "test <- function() {\r\n\u001b[?2004l\r"]
[428.624511, "o", "\u001b[?2004h> "]
[428.625027, "o", "  cat(\"============================================================\\n\")\r\n\u001b[?2004l\r"]
[428.625084, "o", "\u001b[?2004h> "]
[428.625572, "o", "  cat(\" Adaptive Rejection Sampler (Gilks & Wild 1992) test suite\\n\")\r\n\u001b[?2004l\r"]
[428.625628, "o", "\u001b[?2004h> "]
[428.626147, "o", "  cat(\"============================================================\\n\")\r\n\u001b[?2004l\r"]
[428.626206, "o", "\u001b[?2004h> "]
[428.626323, "o", "  set.seed(20240131)\r\n\u001b[?2004l\r"]
[428.62638, "o", "\u001b[?2004h> "]
[428.626484, "o", "  all_pass <- TRUE\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.626541, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[428.627084, "o", "  cat(\"\\n[1] Sampling 5000 draws from N(0,1) via ars(dnorm, c(-Inf, Inf)) ...\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.627253, "o", "> "]
[428.627352, "o", "  s1 <- ars(dnorm, c(-Inf, Inf), n = 5000)\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.627411, "o", "> "]
[428.627571, "o", "  m1 <- mean(s1); sd1 <- sd(s1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.627629, "o", "> "]
[428.62793, "o", "  ks1 <- suppressWarnings(ks.test(s1, \"pnorm\")$p.value)\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.627989, "o", "> "]
[428.628244, "o", "  p1 <- abs(m1) < 0.1 && abs(sd1 - 1) < 0.1 && ks1 > 0.005\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.628301, "o", "> "]
[428.62871, "o", "  cat(sprintf(\"    expected mean = 0, sd = 1; Kolmogorov-Smirnov p-value = %.4f\\n\", ks1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.628767, "o", "> "]
[428.629206, "o", "  cat(sprintf(\"NORMAL_TEST: %s (mean=%.4f, sd=%.4f)\\n\", if (p1) \"PASS\" else \"FAIL\", m1, sd1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.629263, "o", "> "]
[428.629529, "o", "  write(s1, file = \"/app/normal_samples.txt\", ncolumns = 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.629586, "o", "> "]
[428.629872, "o", "  cat(\"    samples saved to /app/normal_samples.txt\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[428.630035, "o", "  all_pass <- all_pass && p1\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.6301, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[428.630484, "o", "  cat(\"\\n[2] Sampling 5000 draws from Exp(1) via ars(dexp, c(0, Inf)) ...\\n\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.630547, "o", "> "]
[428.630713, "o", "  s2 <- ars(dexp, c(0, Inf), n = 5000)\r\n\u001b[?2004l\r"]
[428.630774, "o", "\u001b[?2004h> "]
[428.63093, "o", "  m2 <- mean(s2); sd2 <- sd(s2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.630992, "o", "> "]
[428.631227, "o", "  ks2 <- suppressWarnings(ks.test(s2, \"pexp\")$p.value)\r\n\u001b[?2004l\r"]
[428.631315, "o", "\u001b[?2004h> "]
[428.631572, "o", "  p2 <- abs(m2 - 1) < 0.1 && abs(sd2 - 1) < 0.12 && ks2 > 0.005\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.631632, "o", "> "]
[428.680552, "o", "  cat(sprintf(\"    expected mean = 1, sd = 1; Kolmogorov-Smirnov p-value = %.4f\\n\", ks2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.680662, "o", "> "]
[428.681172, "o", "  cat(sprintf(\"EXPONENTIAL_TEST: %s (mean=%.4f, sd=%.4f)\\n\", if (p2) \"PASS\" else \"FAIL\", m2, sd2))\r\n\u001b[?2004l\r"]
[428.681238, "o", "\u001b[?2004h> "]
[428.681609, "o", "  write(s2, file = \"/app/exponential_samples.txt\", ncolumns = 1)\r\n\u001b[?2004l\r"]
[428.68167, "o", "\u001b[?2004h> "]
[428.682034, "o", "  cat(\"    samples saved to /app/exponential_samples.txt\\n\")\r\n\u001b[?2004l\r"]
[428.682096, "o", "\u001b[?2004h> "]
[428.682259, "o", "  all_pass <- all_pass && p2\r\n\u001b[?2004l\r"]
[428.682319, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[428.682431, "o", "\u001b[?2004h> "]
[428.682801, "o", "  cat(\"\\n[3] Sampling 5000 draws from Gamma(shape=3) on (0, Inf) ...\\n\")\r\n\u001b[?2004l\r"]
[428.682857, "o", "\u001b[?2004h> "]
[428.683259, "o", "  s3 <- ars(function(x) dgamma(x, shape = 3), c(0, Inf), n = 5000)\r\n\u001b[?2004l\r"]
[428.683317, "o", "\u001b[?2004h> "]
[428.683499, "o", "  m3 <- mean(s3); sd3 <- sd(s3)\r\n\u001b[?2004l\r"]
[428.683556, "o", "\u001b[?2004h> "]
[428.683971, "o", "  ks3 <- suppressWarnings(ks.test(s3, \"pgamma\", shape = 3)$p.value)\r\n\u001b[?2004l\r"]
[428.684031, "o", "\u001b[?2004h> "]
[428.684445, "o", "  p3 <- abs(m3 - 3) < 0.15 && abs(sd3 - sqrt(3)) < 0.15 && ks3 > 0.005\r\n\u001b[?2004l\r"]
[428.684501, "o", "\u001b[?2004h> "]
[428.685016, "o", "  cat(sprintf(\"    expected mean = 3, sd = %.4f; KS p-value = %.4f\\n\", sqrt(3), ks3))\r\n\u001b[?2004l\r"]
[428.685075, "o", "\u001b[?2004h> "]
[428.685612, "o", "  cat(sprintf(\"GAMMA_TEST: %s (mean=%.4f, sd=%.4f)\\n\", if (p3) \"PASS\" else \"FAIL\", m3, sd3))\r\n\u001b[?2004l\r"]
[428.685669, "o", "\u001b[?2004h> "]
[428.685841, "o", "  all_pass <- all_pass && p3\r\n\u001b[?2004l\r"]
[428.685906, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[428.685975, "o", "\u001b[?2004h> "]
[428.686496, "o", "  cat(\"\\n[4] Sampling 3000 draws from an *unnormalized* normal kernel exp(-x^2/2) ...\\n\")\r\n\u001b[?2004l\r"]
[428.686555, "o", "\u001b[?2004h> "]
[428.686929, "o", "  s4 <- ars(function(x) exp(-x^2 / 2), c(-Inf, Inf), n = 3000)\r\n\u001b[?2004l\r"]
[428.686988, "o", "\u001b[?2004h> "]
[428.687144, "o", "  m4 <- mean(s4); sd4 <- sd(s4)\r\n\u001b[?2004l\r"]
[428.687168, "o", "\u001b[?2004h"]
[428.687195, "o", "> "]
[428.687465, "o", "  p4 <- abs(m4) < 0.12 && abs(sd4 - 1) < 0.12\r\n\u001b[?2004l\r"]
[428.687508, "o", "\u001b[?2004h> "]
[428.688133, "o", "  cat(sprintf(\"UNNORMALIZED_TEST: %s (mean=%.4f, sd=%.4f)\\n\", if (p4) \"PASS\" else \"FAIL\", m4, sd4))\r\n\u001b[?2004l\r"]
[428.688171, "o", "\u001b[?2004h"]
[428.688196, "o", "> "]
[428.688363, "o", "  all_pass <- all_pass && p4\r\n\u001b[?2004l\r"]
[428.688402, "o", "\u001b[?2004h"]
[428.688442, "o", "> \r\n\u001b[?2004l\r"]
[428.688477, "o", "\u001b[?2004h> "]
[428.689023, "o", "  cat(\"\\n[5] Module test: upper hull dominates log-density, lower hull is dominated ...\\n\")\r\n\u001b[?2004l\r"]
[428.689063, "o", "\u001b[?2004h> "]
[428.689218, "o", "  hfun <- make_h(dnorm)\r\n\u001b[?2004l\r"]
[428.689254, "o", "\u001b[?2004h"]
[428.689294, "o", "> "]
[428.689503, "o", "  st <- init_state(hfun, c(-Inf, Inf))\r\n\u001b[?2004l\r"]
[428.689538, "o", "\u001b[?2004h"]
[428.689563, "o", "> "]
[428.689777, "o", "  xs <- seq(-3, 3, length.out = 201)\r\n\u001b[?2004l\r"]
[428.689822, "o", "\u001b[?2004h"]
[428.689857, "o", "> "]
[428.690245, "o", "  uv <- eval_upper(st, xs); lv <- eval_lower(st, xs); hv <- hfun(xs)\r\n\u001b[?2004l\r"]
[428.690281, "o", "\u001b[?2004h"]
[428.690307, "o", "> "]
[428.690607, "o", "  p5 <- all(uv >= hv - 1e-6) && all(lv <= hv + 1e-6)\r\n\u001b[?2004l\r"]
[428.690643, "o", "\u001b[?2004h"]
[428.690683, "o", "> "]
[428.691047, "o", "  cat(sprintf(\"HULL_TEST: %s (max(h-u)=%.2e, max(l-h)=%.2e)\\n\",\r\n\u001b[?2004l\r"]
[428.691087, "o", "\u001b[?2004h"]
[428.691112, "o", "> "]
[428.691516, "o", "              if (p5) \"PASS\" else \"FAIL\", max(hv - uv), max(lv - hv)))\r\n\u001b[?2004l\r"]
[428.691555, "o", "\u001b[?2004h"]
[428.691595, "o", "> "]
[428.691739, "o", "  all_pass <- all_pass && p5\r\n\u001b[?2004l\r"]
[428.691776, "o", "\u001b[?2004h"]
[428.691801, "o", "> \r\n\u001b[?2004l\r"]
[428.691851, "o", "\u001b[?2004h> "]
[428.692283, "o", "  cat(\"\\n[6] Input validation: invalid inputs must raise errors ...\\n\")\r\n\u001b[?2004l\r"]
[428.692322, "o", "\u001b[?2004h"]
[428.692346, "o", "> "]
[428.692885, "o", "  e1 <- inherits(tryCatch(ars(dnorm, c(-Inf, Inf), n = -5), error = function(e) e), \"error\")\r\n\u001b[?2004l\r"]
[428.69293, "o", "\u001b[?2004h> "]
[428.693526, "o", "  cat(sprintf(\"INVALID_N_TEST: %s (negative sample count rejected)\\n\", if (e1) \"PASS\" else \"FAIL\"))\r\n\u001b[?2004l\r"]
[428.693564, "o", "\u001b[?2004h"]
[428.693587, "o", "> "]
[428.694115, "o", "  e2 <- inherits(tryCatch(ars(dnorm, c(2, -2), n = 100), error = function(e) e), \"error\")\r\n\u001b[?2004l\r"]
[428.694154, "o", "\u001b[?2004h"]
[428.694189, "o", "> "]
[428.694793, "o", "  cat(sprintf(\"INVALID_DOMAIN_TEST: %s (reversed domain rejected)\\n\", if (e2) \"PASS\" else \"FAIL\"))\r\n\u001b[?2004l\r"]
[428.694831, "o", "\u001b[?2004h"]
[428.694866, "o", "> "]
[428.695482, "o", "  e3 <- inherits(tryCatch(ars(\"not_a_function\", c(-Inf, Inf), n = 100), error = function(e) e), \"error\")\r\n\u001b[?2004l\r"]
[428.695535, "o", "\u001b[?2004h> "]
[428.696191, "o", "  cat(sprintf(\"INVALID_DENSITY_TEST: %s (non-function density rejected)\\n\", if (e3) \"PASS\" else \"FAIL\"))\r\n\u001b[?2004l\r"]
[428.696223, "o", "\u001b[?2004h"]
[428.696243, "o", "> "]
[428.69651, "o", "  all_pass <- all_pass && e1 && e2 && e3\r\n\u001b[?2004l\r"]
[428.696543, "o", "\u001b[?2004h"]
[428.696562, "o", "> \r\n\u001b[?2004l\r"]
[428.696605, "o", "\u001b[?2004h"]
[428.696639, "o", "> "]
[428.697133, "o", "  cat(\"\\n[7] Non-log-concave densities must be detected during sampling ...\\n\")\r\n\u001b[?2004l\r"]
[428.697177, "o", "\u001b[?2004h"]
[428.697198, "o", "> "]
[428.697714, "o", "  e4 <- tryCatch({ ars(dcauchy, c(-Inf, Inf), n = 2000); NULL }, error = function(e) e)\r\n\u001b[?2004l\r"]
[428.69775, "o", "\u001b[?2004h"]
[428.697769, "o", "> "]
[428.697964, "o", "  ok4 <- inherits(e4, \"error\")\r\n\u001b[?2004l\r"]
[428.697999, "o", "\u001b[?2004h"]
[428.69802, "o", "> "]
[428.698514, "o", "  if (ok4) cat(\"    caught expected error: \", conditionMessage(e4), \"\\n\", sep = \"\")\r\n\u001b[?2004l\r"]
[428.698545, "o", "\u001b[?2004h"]
[428.698563, "o", "> "]
[428.69905, "o", "  cat(sprintf(\"NON_LOG_CONCAVE_CAUCHY_TEST: %s\\n\", if (ok4) \"PASS\" else \"FAIL\"))\r\n\u001b[?2004l\r"]
[428.69908, "o", "\u001b[?2004h"]
[428.699108, "o", "> "]
[428.699455, "o", "  mix <- function(x) 0.5 * dnorm(x, -3) + 0.5 * dnorm(x, 3)\r\n\u001b[?2004l\r"]
[428.699489, "o", "\u001b[?2004h"]
[428.699509, "o", "> "]
[428.700013, "o", "  e5 <- tryCatch({ ars(mix, c(-Inf, Inf), n = 2000); NULL }, error = function(e) e)\r\n\u001b[?2004l\r"]
[428.700046, "o", "\u001b[?2004h"]
[428.700066, "o", "> "]
[428.700252, "o", "  ok5 <- inherits(e5, \"error\")\r\n\u001b[?2004l\r"]
[428.700282, "o", "\u001b[?2004h"]
[428.700301, "o", "> "]
[428.700799, "o", "  if (ok5) cat(\"    caught expected error: \", conditionMessage(e5), \"\\n\", sep = \"\")\r\n\u001b[?2004l\r"]
[428.70083, "o", "\u001b[?2004h"]
[428.70085, "o", "> "]
[428.701344, "o", "  cat(sprintf(\"NON_LOG_CONCAVE_MIXTURE_TEST: %s\\n\", if (ok5) \"PASS\" else \"FAIL\"))\r\n\u001b[?2004l\r"]
[428.701374, "o", "\u001b[?2004h"]
[428.701392, "o", "> "]
[428.701616, "o", "  all_pass <- all_pass && ok4 && ok5\r\n\u001b[?2004l\r"]
[428.701659, "o", "\u001b[?2004h"]
[428.701688, "o", "> \r\n\u001b[?2004l\r"]
[428.701718, "o", "\u001b[?2004h"]
[428.701739, "o", "> "]
[428.70218, "o", "  cat(\"\\n============================================================\\n\")\r\n\u001b[?2004l\r"]
[428.702212, "o", "\u001b[?2004h"]
[428.702231, "o", "> "]
[428.702773, "o", "  cat(sprintf(\"OVERALL: %s\\n\", if (all_pass) \"ALL TESTS PASSED\" else \"SOME TESTS FAILED\"))\r\n\u001b[?2004l\r"]
[428.702807, "o", "\u001b[?2004h"]
[428.702827, "o", "> "]
[428.703278, "o", "  cat(\"============================================================\\n\")\r\n\u001b[?2004l\r"]
[428.703313, "o", "\u001b[?2004h"]
[428.703333, "o", "> "]
[428.703466, "o", "  invisible(all_pass)\r\n\u001b[?2004l\r"]
[428.7035, "o", "\u001b[?2004h"]
[428.703535, "o", "> "]
[428.703555, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[428.703598, "o", "> "]
[428.703619, "o", "EOF\r\n\u001b[?2004l\r"]
