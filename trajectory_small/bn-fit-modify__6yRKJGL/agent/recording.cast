[335.418661, "i", "cat > /tmp/check.R << 'EOF'\nlibrary(bnlearn)\ndf <- read.csv('/app/bn_sample_10k.csv')\ncat('M_Y|U: '); print(ci.test('M','Y','U',data=df)$p.value)\ncat('M_Y|U,R: '); print(ci.test('M','Y',c('U','R'),data=df)$p.value)\ncat('U_M|Y,R: '); print(ci.test('U','M',c('Y','R'),data=df)$p.value)\ncat('D_Y|U: '); print(ci.test('D','Y','U',data=df)$p.value)\ncat('U_D|Y: '); print(ci.test('U','D','Y',data=df)$p.value)\nA <- model2network('[U][Y|U][R|U][D|U:Y][M|U:R]')\nB <- model2network('[U][Y|U][R|U][D|U:Y][M|Y:R]')\nC <- model2network('[U][R|U][M|U:R][Y|U:M][D|U:Y]')\ncat('BIC A:', score(A, df, type='bic-g'), '\\n')\ncat('BIC B:', score(B, df, type='bic-g'), '\\n')\ncat('BIC C:', score(C, df, type='bic-g'), '\\n')\nhcg <- hc(df, restart=20)\ncat('HC restart arcs:\\n'); print(arcs(hcg)); cat('BIC HC:', score(hcg, df, type='bic-g'), '\\n')\nEOF\nRscript /tmp/check.R\n"]
