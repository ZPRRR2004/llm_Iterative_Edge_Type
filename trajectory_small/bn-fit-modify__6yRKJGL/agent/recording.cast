[389.802575, "i", "cat > /tmp/final.R << 'EOF'\nlibrary(bnlearn)\ndf <- read.csv('/app/bn_sample_10k.csv')\ndag <- model2network('[U][Y|U][R|U][D|U:Y][M|U:R]')\na <- arcs(dag)\nout <- data.frame(to=a[,'to'], from=a[,'from'])\nwrite.csv(out, '/app/learned_dag.csv', row.names=FALSE, quote=FALSE)\nfit <- bn.fit(dag, df)\nmut <- mutilated(fit, evidence=list(Y=0))\nma <- arcs(bn.net(mut))\nout2 <- data.frame(to=ma[,'to'], from=ma[,'from'])\nwrite.csv(out2, '/app/intervened_dag.csv', row.names=FALSE, quote=FALSE)\nset.seed(42)\nsamp <- rbn(mut, n=10000)\nsamp <- samp[, c('U','Y','R','D','M')]\nwrite.csv(samp, '/app/final_bn_sample.csv', row.names=FALSE)\ncat('done\\n')\nprint(summary(samp))\nEOF\nRscript /tmp/final.R\n"]
[389.803047, "o", "cat > /tmp/final.R << 'EOF'\r\n\u001b[?2004l\r"]
