[348.028345, "o", "vat = round(sum(r[2] for r in rows), 2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[348.028387, "o", "> "]
[348.028617, "o", "with open(\"/app/invoices/summary.csv\", \"w\", newline=\"\") as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[348.028715, "o", "    w = csv.writer(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[348.028884, "o", "    w.writerow([\"filename\", \"total_amount\", \"vat_amount\"])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[348.028919, "o", "    for r in rows:\r\n\u001b[?2004l\r"]
[348.030664, "o", "\u001b[?2004h>         w.writerow([r[0], f\"{r[1]:.2f}\", f\"{r[2]:.2f}\"])\r\n\u001b[?2004l\r\u001b[?2004h>     w.writerow([\"total\", f\"{tot:.2f}\", f\"{vat:.2f}\"])\r\n\u001b[?2004l\r\u001b[?2004h> print(\"done\", tot, vat)\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[348.043245, "o", "done 81315.2 5402.48\r\n"]
